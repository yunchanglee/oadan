<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_4x2_stage_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌴 케토시스 · 16:8"
            android:textColor="#16796B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_4x2_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="14h 24m"
            android:textColor="#1E2A28"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_4x2_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="13:30 종료 · 1h 35m 남음"
            android:textColor="#5C6663"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/widget_4x2_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="88"
            android:progressTint="#16796B" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/widget_btn_water"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#E8F5F2"
                android:text="💧 +250ml"
                android:textColor="#106357"
                android:textSize="12sp" />

            <Button
                android:id="@+id/widget_btn_toggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#F1EADF"
                android:text="공복 마치기"
                android:textColor="#1E2A28"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
