<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_2x2_stage_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌴"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/widget_2x2_elapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="14h 24m"
        android:textColor="#1E2A28"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_2x2_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="목표까지 1h 35m"
        android:textColor="#5C6663"
        android:textSize="11sp" />

</LinearLayout>
